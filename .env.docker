# Docker Environment Variables
# Copy to .env and customize if needed

# Application
PORT=3000
NODE_ENV=development

# Database (uses Docker service name 'postgres')
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=github_tracker
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Redis (uses Docker service name 'redis')
REDIS_HOST=redis
REDIS_PORT=6379

# GitHub App credentials (use your actual values or leave as placeholder)
GITHUB_APP_ID=1
GITHUB_PRIVATE_KEY=placeholder
GITHUB_WEBHOOK_SECRET=dev-secret-change-in-production
GITHUB_INSTALLATION_ID=1

# JWT authentication (generate fresh if needed)
JWT_SECRET=472838f1f2f3643015f92373d2b28b0a14adcd7255341189713571fec18abe5f588d1ac278da4150735711d0ba4fa70f81f0d95ffd9b8a9af9bb18984b654ab0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000
