# Application
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=github_tracker
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Redis (job queue + idempotency cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# GitHub App credentials
# App ID from GitHub App settings page (numeric, e.g. 123456)
GITHUB_APP_ID=

# Private key content from the .pem file downloaded when creating GitHub App
# Replace newlines with \n for single-line env var, OR use GITHUB_PRIVATE_KEY_PATH
GITHUB_PRIVATE_KEY=

# Webhook secret set in GitHub App settings (random string, min 32 chars)
GITHUB_WEBHOOK_SECRET=

# Installation ID for the GitHub App installation on the target org
# Found in GitHub App settings -> Installations
GITHUB_INSTALLATION_ID=

# JWT authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# MUST be >=32 chars and non-default in production (startup guard enforced)
JWT_SECRET=changeme_generate_with_crypto_randomBytes_64

# Proxy trust (set to 'true' only behind a trusted reverse proxy)
TRUST_PROXY=false

# Swagger (disabled by default; set to 'true' to enable API docs UI)
ENABLE_SWAGGER=true

# Production transport security
# REDIS_PASSWORD=       # Required in production
# REDIS_TLS=false       # Set to 'true' for TLS-encrypted Redis
# DATABASE_SSL=false    # Set to 'true' for TLS-encrypted Postgres
# DATABASE_PASSWORD=    # Must be non-default in production
